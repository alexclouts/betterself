# Copier ce fichier vers .env et l'adapter. Le fichier .env n'est jamais commité.
# Toutes les variables sont facultatives en développement : sans elles, les
# valeurs par défaut de core/config.py (PostgreSQL et Mailpit de docker-compose) s'appliquent.

# Base de données
# DATABASE_URL=postgresql+psycopg://betterself:betterself@localhost:5432/betterself

# Signature des jetons JWT. En production : une longue valeur aléatoire, par exemple
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=change-me-in-development

# Catalogue Open Food Facts (facultatif)
# OFF_CATALOG_PATH=/chemin/vers/off.sqlite

# Envoi des courriels. Par défaut : Mailpit (http://localhost:8025).
# Avec une vraie boîte courriel, utiliser les paramètres SMTP donnés par l'hébergeur :
#   port 587 avec SMTP_STARTTLS=true (recommandé).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# MAIL_FROM="BetterSelf <no-reply@exemple.com>"
# MAIL_REPLY_TO=support@exemple.com

# Adresse du frontend, utilisée dans les liens envoyés par courriel
# FRONTEND_URL=http://localhost:8080
# En mode « lan » (npm run dev:lan), pour ouvrir le lien sur un téléphone :
# FRONTEND_URL=https://<adresse IP de cet ordinateur>:8080
